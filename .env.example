# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，请不要把真实凭证提交到仓库。

# ============ 小爱音箱账号 ============
MI_SPEAKER_DID=小爱音箱Play
MI_USER_ID=xiaomizhanghaoidxxxx
MI_PASSWORD=xiaomizhanghaomimaxxxx
# 登录失败时改用 passToken
MI_PASS_TOKEN=xiaomizhanghaopasstokenxxxx

# ============ 外接大模型（OpenAI 兼容接口）============
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=apikeyxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=MiniMax-M3.1-Flash

# ============ MiniMax 语音合成 ============
# 语音来源：minimax（音色自然，约 1.5-2s） / xiaoai（小爱原生 TTS，约 0.6s，音色机械）
TTS_PROVIDER=minimax
# 留空则复用上面的 OPENAI_BASE_URL / OPENAI_API_KEY
TTS_BASE_URL=
TTS_API_KEY=
TTS_VOICE_ID=male-qn-qingse
# 音箱访问不到局域网地址时填公网地址
TTS_PUBLIC_BASE_URL=

# ============ 语音控制电脑（默认关闭）============
# 开启后只会执行 config.js 里 pcControl.commands 白名单中的命令
PC_CONTROL_ENABLED=false
# 执行指令时压低音量的时长（毫秒）：让小爱原生兜底回答在静音里说完，越大越干净但反馈越慢，0 为关闭
PC_CONTROL_MUTE_MS=2500
